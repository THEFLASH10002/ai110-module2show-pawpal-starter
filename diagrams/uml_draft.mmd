classDiagram
    %% PawPal+ working diagram. Drafted in Phase 2, revised in Phase 3 after
    %% reviewing the skeleton, and updated again as the scheduling logic grew.

    class Owner {
        +str name
        +int available_minutes
        +list~tuple~ blocked_windows
        +list~Pet~ pets
        +add_pet(pet Pet) void
        +set_availability(minutes int) void
        +block_window(start str, end str) void
        +blocking_window(start str, duration int) tuple
        +overlaps_blocked(start str, duration int) bool
        +all_tasks() list~tuple~
        +pending_tasks() list~tuple~
        +filter_tasks(pet_name, completed, priority, due_on) list~tuple~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~Task~ tasks
        +add_task(task Task) void
        +find_task(task_id str) Task
        +edit_task(task_id str, **changes) bool
        +remove_task(task_id str) bool
        +pending_tasks() list~Task~
        +complete_task(task_id str) Task
    }

    class Task {
        +str task_id
        +str title
        +int duration_minutes
        +str priority
        +str frequency
        +str preferred_time
        +date due_date
        +bool is_complete
        +mark_complete() void
        +mark_incomplete() void
        +next_due_date() date
        +next_occurrence() Task
        +window() tuple
        +priority_rank() int
        +fits_in(minutes_left int) bool
    }

    class PlannedItem {
        +Task task
        +Pet pet
        +str start_time
        +str reason
        +end_time() str
    }

    class Scheduler {
        +Owner owner
        +str day_ends
        +date today
        +collect_tasks() list~PlannedItem~
        +sort_by_time(items list) list~PlannedItem~
        +sort_by_priority(items list) list~PlannedItem~
        +detect_conflicts(items list) list~str~
        +select_tasks(items list) tuple
        +assign_times(items list, start str) tuple
        +generate_plan(start str) tuple
        +explain_plan(planned list, skipped list) str
    }

    Owner "1" --> "*" Pet : cares for
    Pet "1" --> "*" Task : needs
    Scheduler "1" --> "1" Owner : reads constraints and all pets
    Scheduler ..> PlannedItem : produces
    PlannedItem --> Task : wraps
    PlannedItem --> Pet : belongs to
