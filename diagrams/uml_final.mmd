classDiagram
    %% PawPal+ final architecture, matching pawpal_system.py as built.
    %% Private helpers are shown with - because they exist to keep the public
    %% scheduling methods small and testable.

    class Task {
        +str task_id
        +str title
        +int duration_minutes
        +str priority
        +str frequency
        +str preferred_time
        +date due_date
        +bool is_complete
        +mark_complete() void
        +mark_incomplete() void
        +next_due_date() date
        +next_occurrence() Task
        +window() tuple
        +priority_rank() int
        +fits_in(minutes_left int) bool
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~Task~ tasks
        +add_task(task Task) void
        +find_task(task_id str) Task
        +edit_task(task_id str, **changes) bool
        +remove_task(task_id str) bool
        +complete_task(task_id str) Task
        +pending_tasks() list~Task~
    }

    class Owner {
        +str name
        +int available_minutes
        +list~tuple~ blocked_windows
        +list~Pet~ pets
        +add_pet(pet Pet) void
        +set_availability(minutes int) void
        +block_window(start str, end str) void
        +blocking_window(start str, duration int) tuple
        +overlaps_blocked(start str, duration int) bool
        +all_tasks() list~tuple~
        +pending_tasks() list~tuple~
        +filter_tasks(pet_name, completed, priority, due_on) list~tuple~
    }

    class PlannedItem {
        +Task task
        +Pet pet
        +str start_time
        +str reason
        +end_time() str
    }

    class Scheduler {
        +Owner owner
        +str day_ends
        +date today
        +collect_tasks() list~PlannedItem~
        +sort_by_time(items list) list~PlannedItem~
        +sort_by_priority(items list) list~PlannedItem~
        +detect_conflicts(items list) list~str~
        +select_tasks(items list) tuple
        +assign_times(items list, start str) tuple
        +generate_plan(start str) tuple
        +explain_plan(planned list, skipped list) str
        -_clock_key(item PlannedItem) tuple
        -_order_for_clock(items list) list~PlannedItem~
        -_first_free_slot(cursor int, duration int) int
    }

    %% Composition: a Pet's tasks and an Owner's pets do not outlive them.
    Owner "1" *-- "*" Pet : cares for
    Pet "1" *-- "*" Task : needs

    %% The Scheduler reads the household through the Owner and never reaches
    %% into Pet.tasks itself, so one time budget covers every pet.
    Scheduler "1" --> "1" Owner : reads constraints and all pets

    %% PlannedItem is produced per run and keeps scheduling state off Task,
    %% so generating a plan never mutates the pet's own task list.
    Scheduler ..> PlannedItem : produces
    PlannedItem --> Task : wraps
    PlannedItem --> Pet : belongs to
